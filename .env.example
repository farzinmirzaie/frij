# Supabase config for Frij. Copy to `.env` and fill in. NEVER commit `.env`.
# See docs/STORAGE.md.

# Project URL  (Supabase dashboard -> Project Settings -> API -> Project URL)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Anon / public key  (same page). Safe-ish on device/web ONLY with row-level
# security enabled on the table. This is the key the firmware/web app use.
SUPABASE_ANON_KEY=

# Table backing frij_store (see docs/STORAGE.md). Default: store
SUPABASE_TABLE=store

# service_role key: server/admin ONLY — never put it on the device or web app.
# SUPABASE_SERVICE_ROLE_KEY=
