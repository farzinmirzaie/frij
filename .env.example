# Supabase config for Frij. Copy to `.env` and fill in. NEVER commit `.env`.
# See docs/STORAGE.md.

# Project URL  (Supabase dashboard -> Settings -> Data API, or <ref>.supabase.co)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Client key: the "Publishable key" (sb_publishable_...) from Settings > API Keys.
# (Replaces the old anon key; same role. Safe on device/web with RLS enabled.)
SUPABASE_ANON_KEY=

# Table backing frij_store (see docs/STORAGE.md). Default: store
SUPABASE_TABLE=store

# service_role key: server/admin ONLY — never put it on the device or web app.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Google Keep → todo bridge (off-device; see bridge/README.md) ------------
# Only needed if you run the Keep sync. The bridge reuses the Supabase values
# above; add these too. The master token is as sensitive as the account
# password — never commit a filled-in .env.
# GKEEP_EMAIL=you@gmail.com
# GKEEP_MASTER_TOKEN=          # from bridge/get_master_token.py
# GKEEP_LIST_TITLE=Todos       # exact title of the shared Keep list note

# --- Google Calendar → events bridge (off-device; see bridge/README.md) ------
# Only needed if you run the calendar sync. The calendar's "Secret address in
# iCal format" (Google Calendar > Settings > Integrate calendar) — grants read
# access to the whole calendar, treat it like a password.
# FRIJ_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
