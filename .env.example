# Supabase config for Frij. Copy to `.env` and fill in. NEVER commit `.env`.
# See docs/STORAGE.md.

# Project URL  (Supabase dashboard -> Settings -> Data API, or <ref>.supabase.co)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Client key: the "Publishable key" (sb_publishable_...) from Settings > API Keys.
# (Replaces the old anon key; same role. Safe on device/web with RLS enabled.)
SUPABASE_ANON_KEY=

# Table backing frij_store (see docs/STORAGE.md). Default: store
SUPABASE_TABLE=store

# service_role key: server/admin ONLY — never put it on the device or web app.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Google Keep → checklist bridge (off-device; see bridge/README.md) -------
# Only needed if you run the Keep sync. The bridge reuses the Supabase values
# above; add these too. The master token is as sensitive as the account
# password — never commit a filled-in .env.
# GKEEP_EMAIL=you@gmail.com
# GKEEP_MASTER_TOKEN=          # from bridge/get_master_token.py
# Declare one note per GKEEP_NOTE_* variable, value = storeKey,noteTitle (split
# on the first comma, so titles may contain commas). The bridge syncs the Keep
# note titled noteTitle to store:<storeKey>; device apps read that key. Add as
# many as you like.
# GKEEP_NOTE_TODO=todo,Todos          # the todo app reads store:todo
# GKEEP_NOTE_GROCERIES=groceries,Groceries

# --- Google Calendar → events bridge (off-device; see bridge/README.md) ------
# Only needed if you run the calendar sync. Declare one calendar per GCALENDAR_*
# variable, value = url,name,color:
#   url   the calendar's "Secret address in iCal format" (Google Calendar >
#         Settings > Integrate calendar) — grants read access to the whole
#         calendar, treat it like a password. (URLs have no commas, so the split
#         is unambiguous.)
#   name  short display name; also the per-event tag the device filters/colors on.
#   color 6-hex RRGGBB (leading "#" optional) — the calendar's badge color.
# Every calendar is treated alike; a "holidays" feed is just one given a gray
# color. Add as many as you like (device shows up to 8); each is toggleable.
# GCALENDAR_FAMILY=https://calendar.google.com/calendar/ical/.../basic.ics,Family,F472B6
# GCALENDAR_WORK=https://calendar.google.com/calendar/ical/.../basic.ics,Work,38BDF8
# Public holidays (gray color). Google's Malaysia holidays calendar is public — no secret:
# GCALENDAR_HOLIDAYS=https://calendar.google.com/calendar/ical/en.malaysia%23holiday%40group.v.calendar.google.com/public/basic.ics,Holidays,6B6B74
# Special case: GCALENDAR_COMPANY (StashAway BambooHR feed) keeps only [MY]
# entries and strips the "Company Holiday - [MY] " prefix. Name it as you like:
# GCALENDAR_COMPANY=https://stashaway.bamboohr.com/feeds/feed.php?id=...,Company Holidays,FACC15
# Home timezone (IANA name) for event clock times — needed when a calendar's own
# timezone is UTC (Google then exports bare UTC instants).
# FRIJ_TZ=Asia/Kuala_Lumpur

# Couples app milestone dates (YYYY-MM-DD), baked into the firmware at build time
# and shown on the "Together since" screen as elapsed years/months/days. Unset →
# the screen shows "Not set".
# FRIJ_TOGETHER_SINCE=2022-01-07
# FRIJ_MARRIED_SINCE=2023-01-17
